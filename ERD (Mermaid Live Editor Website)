---
config:
  themeVariables:
    primaryColor: '#000000'
    primaryTextColor: '#000000'
    primaryBorderColor: '#000000'
    lineColor: '#000000'
    secondaryColor: '#ffffff'
    tertiaryColor: '#ffffff'
  layout: dagre
---
erDiagram
    direction TB

    USER {
        int id PK ""  
        string name  ""  
        string email  ""  
        string phone  ""  
        string role  ""  
        string department  ""  
        string joined_date  ""  
        string status  ""  
        string last_login  ""  
        string avatar  ""  
    }

    WORKER {
        int id PK ""  
        int userId FK ""  
        string name  ""  
        string team  ""  
        string phone  ""  
        string email  ""  
        int tasksToday  ""  
        int tasksCompleted  ""  
        string status  ""  
    }

    COLLECTION {
        int id PK ""  
        varchar binId FK ""  
        string assignedTo ""  
        string location  ""  
        string priority  ""  
        string status  ""  
        decimal capacity  ""  
        string scheduledTime  ""  
        string completedAt  ""  
    }

    BIN {
        varchar id PK ""  
        string location  ""  
        decimal weight  ""  
        decimal capacity  ""  
        decimal fillLevel ""
        decimal nh3  ""  
        decimal ch4  ""  
        string odorLevel ""
        string status  ""  
    }

    ALERT {
        int id PK ""  
        varchar binId FK ""  
        string type  ""  
        string message  ""  
        string time  ""  
        string severity  ""  
        boolean read  ""  
    }

    ROT_INDEX {
        int id PK ""  
        varchar binId FK ""  
        string time  ""  
        decimal nh3  ""  
        decimal ch4  ""  
        decimal rotIndex  ""  
        string area  ""  
    }

    LOCATION {
        varchar binId PK "FK"  
        string location  ""  
        decimal lat  ""  
        decimal lng  ""  
        string status  ""  
        decimal capacity  ""  
        string lastCollection  ""  
    }

    MAINTENANCE {
        varchar binId PK "FK"  
        string location ""
        string sensors  ""  
        decimal battery  ""  
        string connectivity  ""  
        string lastMaintenance  ""  
        string status  ""  
        string scheduledDate  ""  
    }

    %% Relationships
    USER ||--o{ WORKER : "manages"
    USER ||--o{ COLLECTION : "creates"
    WORKER ||--o{ COLLECTION : "performs"
    COLLECTION }o--|| BIN : "targets"
    BIN ||--o{ ALERT : "triggers"
    BIN ||--o{ ROT_INDEX : "logs"
    BIN ||--|| LOCATION : "located at"
    BIN ||--|| MAINTENANCE : "maintained by"

    %% Styles (black + white only)
    style USER stroke:#000000,fill:#FFFFFF
    style WORKER stroke:#000000,fill:#FFFFFF
    style COLLECTION stroke:#000000,fill:#FFFFFF
    style BIN stroke:#000000,fill:#FFFFFF
    style ALERT stroke:#000000,fill:#FFFFFF
    style ROT_INDEX stroke:#000000,fill:#FFFFFF
    style LOCATION stroke:#000000,fill:#FFFFFF
    style MAINTENANCE stroke:#000000,fill:#FFFFFF